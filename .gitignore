# ---------------------------------------------------------------
# Simulador de Escalonamento de Tarefas
# Sistemas Operacionais
#
# ATENCAO: nao acrescente "dist/" sem ler o comentario da secao
# PyInstaller abaixo. O executavel faz parte da entrega.
# ---------------------------------------------------------------

# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Ambientes virtuais
.venv/
venv/
env/
myenv/
ENV/

# PyInstaller
# O executavel entregue fica na RAIZ do repositorio, como
# Simulador.exe. As pastas de trabalho do PyInstaller nao entram:
# sao geradas a cada build e somam centenas de megabytes.
build/
dist/
*.spec

# Editores
.vscode/
.idea/
*.swp
*.swo

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# Jupyter
.ipynb_checkpoints/

# Saidas temporarias de execucao
*.log
saida_temp/
